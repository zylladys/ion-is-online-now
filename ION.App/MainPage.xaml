<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ION.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#101114">

    <ScrollView>
        <VerticalStackLayout
            Padding="28"
            Spacing="24"
            VerticalOptions="Center">

            <VerticalStackLayout
                Spacing="2"
                HorizontalOptions="Center">

                <HorizontalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="I"
                        FontSize="64"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Border
                        x:Name="LogoStatusIndicator"
                        WidthRequest="58"
                        HeightRequest="58"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 29">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnLogoStatusTapped" />
                        </Border.GestureRecognizers>

                        <Label
                            x:Name="LogoStatusLabel"
                            Text="○"
                            FontSize="64"
                            FontAttributes="Bold"
                            TextColor="#7D8490"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="N"
                        FontSize="64"
                        FontAttributes="Bold"
                        TextColor="White" />

                </HorizontalStackLayout>

                <Label
                    Text="IS ONLINE NOW"
                    FontSize="14"
                    CharacterSpacing="4"
                    TextColor="#8F96A3"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <Border
                Padding="16"
                BackgroundColor="#17191E"
                Stroke="#2A2D34"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <HorizontalStackLayout
                    Spacing="12">

                    <Label
                        x:Name="GlobalStatusIndicator"
                        Text="○"
                        FontSize="22"
                        TextColor="#7D8490"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Spacing="2"
                        VerticalOptions="Center">

                        <Label
                            x:Name="GlobalStatusTitle"
                            Text="OFFLINE"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            x:Name="GlobalStatusDescription"
                            Text="No channels are live right now"
                            FontSize="12"
                            TextColor="#8F96A3" />

                    </VerticalStackLayout>

                </HorizontalStackLayout>

            </Border>

            <VerticalStackLayout
                Spacing="12">

                <Label
                    Text="YOUR CHANNELS"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#8F96A3" />

                <VerticalStackLayout
                    x:Name="ChannelsContainer"
                    Spacing="10">

                    <Border
                        Padding="24"
                        BackgroundColor="#17191E"
                        Stroke="#2A2D34"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="No channels configured"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Add a livestream channel to start monitoring it."
                                FontSize="13"
                                TextColor="#8F96A3"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <Button
                Text="+ Add Channel"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="#E9435B"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnAddChannelClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>